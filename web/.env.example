# From the World developer portal, World ID Configuration. Public.
NEXT_PUBLIC_WORLD_APP_ID=app_

# The relying party. The id is public; the signing key is not — anyone holding it can
# forge requests in your app's name, so it never leaves the server.
WORLD_RP_ID=rp_
WORLD_RP_SIGNING_KEY=

# Action ids are free-form strings you choose; nothing is registered in the portal.
NEXT_PUBLIC_WORLD_ACTION_AGE=age
NEXT_PUBLIC_WORLD_ACTION_SELFIE=selfie

# What the age gate actually asks for
NEXT_PUBLIC_MINIMUM_AGE=18

# Which World to talk to: production, staging or sandbox. A sandbox app can only be
# reached by the sandbox build of World App.
NEXT_PUBLIC_WORLD_ENV=sandbox
