# This node's operator key. The only key it holds; it is not a user key.
NODE_PRIVATE_KEY=

# Where the contracts are
SEPOLIA_RPC=
IDENTITY_REGISTRY=
APP_REGISTRY=
NODE_REGISTRY=
ACCOUNT_FACTORY=

# The Bee alongside this process. Full node: GSOC subscription needs the
# chunk's neighbourhood, and a light node will subscribe and hear nothing.
BEE_API=http://bee:1633
POSTAGE_BATCH_ID=

# What this node answers on
PORT=8700
GATEWAY_URL=

# Public, protocol-wide. Raises the cost of sweeping a leaked list of subjects
# against the registry; it is not a secret and does not stop a targeted guess.
CREDENTIAL_SALT=
GSOC_TOPIC=manju/shares/v1

# The second sender for email codes — a service this node does not operate.
# Without it, email sign-in is off rather than quietly reduced to one code.
SECOND_SENDER_URL=

# Where this node hands codes to be mailed
MAIL_URL=
