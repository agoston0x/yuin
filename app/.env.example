# From the World developer portal, World ID Configuration. Public — it reaches the browser.
NEXT_PUBLIC_WORLD_APP_ID=app_

# The relying party. The id is public; the signing key is not — anyone holding it can
# forge requests in your app's name, so it never leaves the server.
WORLD_RP_ID=rp_
WORLD_RP_SIGNING_KEY=

# Which World to talk to: production, staging or sandbox. A sandbox app is only reachable
# by the sandbox build of World App, and needs sandbox access approved for the team.
NEXT_PUBLIC_WORLD_ENV=sandbox

# Action ids are free-form strings you choose; nothing is registered in the portal.
NEXT_PUBLIC_WORLD_ACTION_HUMAN=enter
NEXT_PUBLIC_WORLD_ACTION_AGE=age

# What the age gate actually asks for
NEXT_PUBLIC_MINIMUM_AGE=18

# Sepolia, for reading the app registry
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_APP_REGISTRY=
