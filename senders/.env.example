# Who this sender is, as it appears in the mail and in SenderRegistry.
SENDER_LABEL=Yuin
SENDER_PRIVATE_KEY=

# What it signs about. Must match the deployed registry, or the signature is worthless.
CHAIN_ID=11155111
EMAIL_IDENTITY_REGISTRY=

# Delivery. Unset in development: the code is logged instead of sent, so the flow can be
# exercised without a mail account.
MAIL_PROVIDER_API_KEY=
MAIL_FROM=

PORT=8760
